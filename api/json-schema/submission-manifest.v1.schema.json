{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aor.local/submission-manifest.v1.schema.json",
  "title": "AOR Submission Manifest v1",
  "type": "object",
  "required": ["submissionVersion", "projectId", "moduleTaskId", "attemptSeriesId", "attempt", "moduleSpecRef", "baseCommit", "headCommit", "changedFiles", "deletedFiles", "createdFiles", "claimedCriteria", "localTestEvidenceRefs", "agentIdentity", "createdAt", "sha256"],
  "properties": {
    "submissionVersion": {"const": 1},
    "projectId": {"$ref": "common.v1.schema.json#/$defs/opaqueId"},
    "moduleTaskId": {"$ref": "common.v1.schema.json#/$defs/opaqueId"},
    "attemptSeriesId": {"$ref": "common.v1.schema.json#/$defs/opaqueId"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "moduleSpecRef": {"$ref": "common.v1.schema.json#/$defs/specRef"},
    "baseCommit": {"$ref": "common.v1.schema.json#/$defs/commit"},
    "headCommit": {"$ref": "common.v1.schema.json#/$defs/commit"},
    "changedFiles": {"$ref": "#/$defs/paths"},
    "deletedFiles": {"$ref": "#/$defs/paths"},
    "createdFiles": {"$ref": "#/$defs/paths"},
    "claimedCriteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "localTestEvidenceRefs": {"type": "array", "items": {"$ref": "common.v1.schema.json#/$defs/artifactUri"}},
    "agentIdentity": {"$ref": "common.v1.schema.json#/$defs/agentIdentity"},
    "createdAt": {"type": "string", "format": "date-time"},
    "sha256": {"$ref": "common.v1.schema.json#/$defs/sha256"},
    "signature": {"$ref": "common.v1.schema.json#/$defs/signature"}
  },
  "$defs": {
    "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096, "not": {"pattern": "(^|/)\\.\\.(/|$)"}}}
  }
}
