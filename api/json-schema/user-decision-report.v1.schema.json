{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aor.local/user-decision-report.v1.schema.json",
  "title": "AOR Third-Attempt User Decision Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["reportVersion", "projectId", "goalSpec", "moduleTaskId", "moduleName", "state", "attemptLimit", "attempts", "blockingFindings", "dependencyImpact", "costSummary", "allowedDecisions", "generatedAt", "signature"],
  "properties": {
    "reportVersion": {"const": "1.0"},
    "projectId": {"$ref": "common.v1.schema.json#/$defs/opaqueId"},
    "goalSpec": {"$ref": "common.v1.schema.json#/$defs/specRef"},
    "moduleTaskId": {"$ref": "common.v1.schema.json#/$defs/opaqueId"},
    "moduleName": {"type": "string", "minLength": 1},
    "state": {"const": "BLOCKED_USER_DECISION"},
    "attemptLimit": {"const": 3},
    "attempts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["attempt", "submissionCommit", "failureStage", "findingIds", "evidenceUri"], "properties": {"attempt": {"type": "integer", "minimum": 1, "maximum": 3}, "submissionCommit": {"$ref": "common.v1.schema.json#/$defs/commit"}, "failureStage": {"enum": ["DETERMINISTIC_AUDIT", "LLM_AUDIT"]}, "findingIds": {"type": "array"}, "evidenceUri": {"$ref": "common.v1.schema.json#/$defs/artifactUri"}}}},
    "blockingFindings": {"type": "array", "minItems": 1},
    "dependencyImpact": {"type": "object", "additionalProperties": false, "required": ["frozenTaskIds", "criticalPathImpact"], "properties": {"frozenTaskIds": {"type": "array"}, "criticalPathImpact": {"type": "boolean"}}},
    "costSummary": {"type": "object", "additionalProperties": false, "required": ["inputTokens", "outputTokens", "estimatedCost", "currency"], "properties": {"inputTokens": {"type": "integer", "minimum": 0}, "outputTokens": {"type": "integer", "minimum": 0}, "estimatedCost": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}},
    "allowedDecisions": {"type": "array", "uniqueItems": true, "items": {"enum": ["ABORT_PROJECT", "ABORT_MODULE", "REVISE_GOAL", "REVISE_MODULE_SPEC", "HAND_OFF_TO_HUMAN", "AUTHORIZE_NEW_ATTEMPT_SERIES"]}},
    "generatedAt": {"type": "string", "format": "date-time"},
    "signature": {"$ref": "common.v1.schema.json#/$defs/signature"}
  }
}
