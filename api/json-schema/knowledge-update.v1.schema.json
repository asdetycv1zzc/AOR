{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aor.local/knowledge/knowledge-update.v1.schema.json",
  "title": "Project Knowledge Curator Update v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "updateId",
    "tenantId",
    "projectId",
    "projectVersion",
    "status",
    "proposalDigest",
    "changeSummary",
    "validationReport",
    "proposal",
    "draftUri",
    "draftSha256",
    "sourceRunId",
    "createdAt"
  ],
  "properties": {
    "updateId": {"$ref": "#/$defs/id"},
    "tenantId": {"$ref": "#/$defs/id"},
    "projectId": {"$ref": "#/$defs/id"},
    "projectVersion": {"type": "integer", "minimum": 1},
    "status": {"enum": ["DRAFT", "APPROVED", "APPLIED"]},
    "proposalDigest": {"$ref": "#/$defs/sha256"},
    "changeSummary": {"type": "string", "minLength": 1, "maxLength": 8192},
    "validationReport": {"$ref": "#/$defs/validationReport"},
    "proposal": {"$ref": "#/$defs/proposal"},
    "draftUri": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"},
    "draftSha256": {"$ref": "#/$defs/sha256"},
    "sourceRunId": {"type": "string", "minLength": 1, "maxLength": 128},
    "approvalId": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/sha256"},
    "createdAt": {"type": "string", "format": "date-time"},
    "approvedAt": {"type": "string", "format": "date-time"},
    "appliedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "trust": {"enum": ["SIGNED_POLICY", "CURATED", "PROJECT_APPROVED", "GENERATED_UNREVIEWED", "EXTERNAL_UNTRUSTED"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "revision", "sha256", "trustLevel"],
      "properties": {
        "uri": {"type": "string", "format": "uri", "minLength": 1, "maxLength": 2048},
        "revision": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@=-]{0,255}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "trustLevel": {"$ref": "#/$defs/trust"}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "title", "tags", "trustLevel", "contentType", "content"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(inherited|requirements|architecture|modules|interfaces|decisions|prompts|workflows|tools|security|operations|lessons)/.+"},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "tags": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "trustLevel": {"enum": ["CURATED", "PROJECT_APPROVED", "GENERATED_UNREVIEWED", "EXTERNAL_UNTRUSTED"]},
        "contentType": {"type": "string", "minLength": 1, "maxLength": 256},
        "content": {"type": "string", "minLength": 1, "maxLength": 262144},
        "source": {"$ref": "#/$defs/source"}
      },
      "allOf": [
        {
          "if": {"properties": {"trustLevel": {"const": "CURATED"}}, "required": ["trustLevel"]},
          "then": {"required": ["source"]}
        }
      ]
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "revision", "order"],
      "properties": {
        "projectId": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/sha256"},
        "order": {"type": "integer", "minimum": 0}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseRevision", "parentOrderExplicit", "parents", "overrides", "documents", "deletePaths"],
      "properties": {
        "baseRevision": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"},
        "parentOrderExplicit": {"type": "boolean"},
        "parents": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/parent"}},
        "overrides": {"type": "array", "maxItems": 4096, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "documents": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/document"}},
        "deletePaths": {"type": "array", "maxItems": 4096, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "status"],
      "properties": {
        "ruleId": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"enum": ["PASS", "FAIL"]},
        "path": {"type": "string", "maxLength": 4096},
        "message": {"type": "string", "maxLength": 512}
      }
    },
    "validationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "proposalDigest", "passed", "checks", "sha256"],
      "properties": {
        "version": {"const": 1},
        "proposalDigest": {"$ref": "#/$defs/sha256"},
        "passed": {"const": true},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
