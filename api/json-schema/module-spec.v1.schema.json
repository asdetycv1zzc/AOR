{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aor.local/module-spec.v1.schema.json",
  "title": "AOR ModuleSpec v1",
  "type": "object",
  "required": ["moduleSpecVersion", "moduleId", "projectId", "planVersion", "name", "purpose", "responsibilities", "nonResponsibilities", "inputs", "outputs", "interfaces", "dataOwnership", "dependencies", "allowedPaths", "forbiddenPaths", "executionPlatform", "sandboxLevel", "networkPolicy", "workloadProfile", "toolCapabilities", "knowledgeRefs", "acceptanceCriteria", "testRequirements", "observabilityRequirements", "securityRequirements", "budget", "sha256"],
  "properties": {
    "moduleSpecVersion": {"const": 1},
    "moduleId": {"$ref": "common.v1.schema.json#/$defs/opaqueId"},
    "projectId": {"$ref": "common.v1.schema.json#/$defs/opaqueId"},
    "planVersion": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 4096},
    "responsibilities": {"$ref": "#/$defs/strings"},
    "nonResponsibilities": {"$ref": "#/$defs/strings"},
    "inputs": {"type": "array"},
    "outputs": {"type": "array"},
    "interfaces": {"type": "array"},
    "dataOwnership": {"type": "array"},
    "dependencies": {"type": "array"},
    "allowedPaths": {"$ref": "#/$defs/strings"},
    "forbiddenPaths": {"$ref": "#/$defs/strings"},
    "executionPlatform": {"enum": ["LINUX", "WINDOWS"]},
    "sandboxLevel": {"enum": ["CONTAINER", "NONE"]},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "destinations"],
      "properties": {"mode": {"enum": ["DENY_ALL", "ALLOWLIST", "UNRESTRICTED"]}, "destinations": {"$ref": "#/$defs/strings"}}
    },
    "workloadProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust", "hostileMultiTenant", "requiresNetworkIsolation", "requiresHiddenTestConfidentiality"],
      "properties": {
        "trust": {"enum": ["TRUSTED", "UNTRUSTED"]},
        "hostileMultiTenant": {"type": "boolean"},
        "requiresNetworkIsolation": {"type": "boolean"},
        "requiresHiddenTestConfidentiality": {"type": "boolean"}
      }
    },
    "toolCapabilities": {"$ref": "#/$defs/strings"},
    "toolchainIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"}},
    "toolchains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "goal-spec.v2.schema.json#/$defs/tool"}},
    "verificationEntrypoint": {"type": "string", "minLength": 1, "maxLength": 4096, "description": "Linux uses a POSIX sh .sh file; Windows uses a PowerShell .ps1 file."},
    "knowledgeRefs": {"$ref": "#/$defs/strings"},
    "acceptanceCriteria": {"type": "array", "minItems": 1},
    "testRequirements": {"type": "array", "minItems": 1},
    "observabilityRequirements": {"type": "array"},
    "securityRequirements": {"type": "array", "minItems": 1},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputTokens", "maxOutputTokens", "maxCost", "currency"],
      "properties": {
        "maxInputTokens": {"type": "integer", "minimum": 0},
        "maxOutputTokens": {"type": "integer", "minimum": 0},
        "maxCost": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "sha256": {"$ref": "common.v1.schema.json#/$defs/sha256"}
  },
  "dependentRequired": {
    "toolchainIds": ["toolchains", "verificationEntrypoint"],
    "toolchains": ["toolchainIds", "verificationEntrypoint"],
    "verificationEntrypoint": ["toolchainIds", "toolchains"]
  },
  "allOf": [
    {
      "if": {"properties": {"executionPlatform": {"const": "LINUX"}}, "required": ["executionPlatform"]},
      "then": {"properties": {"sandboxLevel": {"const": "CONTAINER"}, "networkPolicy": {"properties": {"mode": {"enum": ["DENY_ALL", "ALLOWLIST"]}}}, "verificationEntrypoint": {"pattern": "\\.sh$"}}}
    },
    {
      "if": {"properties": {"executionPlatform": {"const": "WINDOWS"}}, "required": ["executionPlatform"]},
      "then": {"properties": {"sandboxLevel": {"const": "NONE"}, "networkPolicy": {"properties": {"mode": {"const": "UNRESTRICTED"}, "destinations": {"maxItems": 0}}}, "workloadProfile": {"properties": {"trust": {"const": "TRUSTED"}, "hostileMultiTenant": {"const": false}, "requiresNetworkIsolation": {"const": false}, "requiresHiddenTestConfidentiality": {"const": false}}}, "verificationEntrypoint": {"pattern": "\\.ps1$"}}}
    }
  ],
  "$defs": {"strings": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 4096}}}
}
