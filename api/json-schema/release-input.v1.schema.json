{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aor.local/supply-chain/release-input.v1.schema.json",
  "title": "AOR Release Assembly Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outputDir",
    "version",
    "sourceUri",
    "sourceCommit",
    "builderIdentity",
    "buildType",
    "invocationId",
    "startedAt",
    "finishedAt",
    "materials",
    "artifacts",
    "dependencies",
    "licenseSource",
    "noticeSource",
    "releaseEvidenceSource",
    "privateKeyFile",
    "kid"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "outputDir": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "sourceUri": {"type": "string", "minLength": 1},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "builderIdentity": {"type": "string", "minLength": 1},
    "buildType": {"type": "string", "minLength": 1},
    "invocationId": {"type": "string", "minLength": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"},
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/material"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dependency"}
    },
    "licenseSource": {"type": "string", "minLength": 1},
    "noticeSource": {"type": "string", "minLength": 1},
    "releaseEvidenceSource": {"type": "string", "minLength": 1},
    "privateKeyFile": {"type": "string", "minLength": 1},
    "kid": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "path", "kind", "mediaType"],
      "properties": {
        "sourcePath": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["binary", "container-image", "deployment"]},
        "mediaType": {"type": "string", "minLength": 1}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sourceUri", "sha256", "license", "licenseText"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sourceUri": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "license": {"type": "string", "minLength": 1},
        "licenseText": {"type": "string", "minLength": 1}
      }
    }
  }
}
