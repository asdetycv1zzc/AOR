{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aor.local/events/knowledge-update-approved.v1.schema.json",
  "title": "Knowledge Update Approved Event Data v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approvalVersion",
    "aggregateVersion",
    "approvalId",
    "tenantId",
    "projectId",
    "approvalType",
    "subjectType",
    "subjectId",
    "subjectVersion",
    "subjectSha256",
    "principalId",
    "reason",
    "constraints",
    "issuedAt",
    "expiresAt",
    "signature"
  ],
  "properties": {
    "approvalVersion": {"const": 1},
    "aggregateVersion": {"type": "integer", "minimum": 1},
    "approvalId": {"$ref": "https://schemas.aor.local/common.v1.schema.json#/$defs/opaqueId"},
    "tenantId": {"$ref": "https://schemas.aor.local/common.v1.schema.json#/$defs/opaqueId"},
    "projectId": {"$ref": "https://schemas.aor.local/common.v1.schema.json#/$defs/opaqueId"},
    "approvalType": {"const": "PERMANENT_SIDE_EFFECT"},
    "subjectType": {"const": "KNOWLEDGE_CHANGE"},
    "subjectId": {"$ref": "https://schemas.aor.local/common.v1.schema.json#/$defs/opaqueId"},
    "subjectVersion": {"type": "integer", "minimum": 1},
    "subjectSha256": {"$ref": "https://schemas.aor.local/common.v1.schema.json#/$defs/sha256"},
    "principalId": {"$ref": "https://schemas.aor.local/common.v1.schema.json#/$defs/opaqueId"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
    "constraints": {"type": "object", "additionalProperties": true},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "minLength": 16, "maxLength": 2048}
  }
}
