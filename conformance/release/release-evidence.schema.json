{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aor.local/conformance/release-evidence.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceVersion", "specVersion", "buildDigest", "startedAt", "completedAt", "environment", "results", "exceptions", "evidenceDigest"],
  "properties": {
    "evidenceVersion": {"type": "string"},
    "specVersion": {"type": "string"},
    "buildDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "startedAt": {"format": "date-time"},
    "completedAt": {"format": "date-time"},
    "environment": {"enum": ["test", "preproduction", "production"]},
    "target": {"type": "string"},
    "results": {"type": "array", "items": {"type": "object", "required": ["requirementId", "status", "tool", "toolVersion"], "properties": {"requirementId": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]}, "evidenceUris": {"type": "array", "items": {"type": "string"}}, "tool": {"type": "string"}, "toolVersion": {"type": "string"}}}},
    "exceptions": {"type": "array", "items": {"type": "string"}},
    "evidenceDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {"type": "object"}
  }
}
