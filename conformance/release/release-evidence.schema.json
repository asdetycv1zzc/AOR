{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aor.local/conformance/release-evidence.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceVersion", "specVersion", "releaseVersion", "sourceCommit", "buildDigest", "startedAt", "completedAt", "environment", "results", "exceptions", "uncoveredRequirements", "evidenceDigest"],
  "properties": {
    "evidenceVersion": {"type": "string"},
    "specVersion": {"type": "string"},
    "releaseVersion": {"type": "string", "minLength": 1},
    "sourceCommit": {"type": "string", "pattern": "^(unknown|[0-9a-f]{40})$"},
    "buildDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "startedAt": {"format": "date-time"},
    "completedAt": {"format": "date-time"},
    "environment": {"enum": ["test", "preproduction", "production"]},
    "target": {"type": "string"},
    "results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["requirementId", "status", "evidenceUris", "tool", "toolVersion"], "properties": {"requirementId": {"type": "string", "pattern": "^AOR-[A-Z]+-[0-9]+$"}, "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]}, "evidenceUris": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "tool": {"type": "string", "minLength": 1}, "toolVersion": {"type": "string", "minLength": 1}}}},
    "exceptions": {"type": "array", "items": {"type": "string"}},
    "uncoveredRequirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AOR-[A-Z]+-[0-9]+$"}},
    "evidenceDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {"type": "object", "additionalProperties": false, "required": ["type", "kid", "value"], "properties": {"type": {"type": "string"}, "kid": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}}
  }
}
